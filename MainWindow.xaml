<Window x:Class="URLScra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URLScra" Width="1280" Height="780" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="URLScra" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Paste URL. Choose engine. Get data." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Margin="0,4,4,4"
                         ToolTip="Masukkan URL penuh, contoh https://example.com"/>

                <Button x:Name="AnalyzeButton"
                        Grid.Column="1"
                        Content="Analyze"
                        Click="AnalyzeButton_Click"
                        MinWidth="110"/>

                <Button x:Name="ExportButton"
                        Grid.Column="2"
                        Content="Export CSV"
                        Click="ExportButton_Click"
                        MinWidth="120"
                        IsEnabled="False"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Engine" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="EngineComboBox" SelectedIndex="0" Width="160" ToolTip="Auto cuba HTML dahulu dan menggunakan browser jika perlu">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Fast HTML"/>
                        <ComboBoxItem Content="Browser"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Output" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="OutputModeComboBox" SelectedIndex="0" Width="170" ToolTip="Pilih cara hasil disusun">
                        <ComboBoxItem Content="Raw Data"/>
                        <ComboBoxItem Content="Smart Records"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Search Criteria" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="SearchCriteriaComboBox" SelectedIndex="0" Width="210" ToolTip="Pilih jenis data yang hendak dicari">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Text"/>
                        <ComboBoxItem Content="Title"/>
                        <ComboBoxItem Content="Price"/>
                        <ComboBoxItem Content="Image"/>
                        <ComboBoxItem Content="Video"/>
                        <ComboBoxItem Content="Audio"/>
                        <ComboBoxItem Content="Link"/>
                        <ComboBoxItem Content="Email"/>
                        <ComboBoxItem Content="Phone"/>
                        <ComboBoxItem Content="Document"/>
                        <ComboBoxItem Content="CSV"/>
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="Table"/>
                        <ComboBoxItem Content="Product"/>
                        <ComboBoxItem Content="Metadata"/>
                        <ComboBoxItem Content="Social"/>
                        <ComboBoxItem Content="Downloadable File"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="Source / Label" Binding="{Binding SourceUrl}" Width="320"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="SmartResultsGrid" ItemsSource="{Binding SmartResults}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" HeadersVisibility="Column"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
                        <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="260"/>
                        <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="*"/>
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="90"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="Ready"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="0 records"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="URLScra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URLScra" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="URLScra" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Paste URL. Choose data. Get results." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UrlTextBox"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     Margin="0,4,4,4"
                     ToolTip="Masukkan URL penuh, contoh https://example.com"/>

            <ComboBox x:Name="SearchCriteriaComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      Margin="4"
                      Padding="10,8"
                      VerticalContentAlignment="Center"
                      Background="#11151B"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      ToolTip="Pilih jenis data yang hendak dicari">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Image"/>
                <ComboBoxItem Content="Price"/>
                <ComboBoxItem Content="Video"/>
                <ComboBoxItem Content="Link"/>
                <ComboBoxItem Content="Doc"/>
                <ComboBoxItem Content="CSV"/>
                <ComboBoxItem Content="Email"/>
            </ComboBox>

            <Button x:Name="AnalyzeButton"
                    Grid.Column="2"
                    Content="Analyze"
                    Click="AnalyzeButton_Click"
                    MinWidth="110"/>

            <Button x:Name="ExportButton"
                    Grid.Column="3"
                    Content="Export CSV"
                    Click="ExportButton_Click"
                    MinWidth="120"
                    IsEnabled="False"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" HeadersVisibility="Column"
                      Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    <DataGridTextColumn Header="Source / Label" Binding="{Binding SourceUrl}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="Ready"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="0 records"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="URLScra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URLScra" Width="1480" Height="880" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="{StaticResource URLScraAppIcon}">
    <Grid Background="{StaticResource BgBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <Grid Grid.Row="0" Margin="4,2,4,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="14" Background="#0B1220"
                        BorderBrush="#3478F6" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="{StaticResource URLScraAppIcon}" Width="46" Height="46"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="URLScra" FontSize="31" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Extract. Preview. Save." FontSize="13" FontWeight="SemiBold"
                               Foreground="#9FC5FF" Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Padding="18,10" CornerRadius="8" Background="#0D1523"
                    BorderBrush="#263750" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Any URL. Find the content." Foreground="#E5EDF8" FontWeight="SemiBold"/>
                    <TextBlock Text="Preview before you save." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Command bar -->
        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14" CornerRadius="10"
                Background="#0D1422" BorderBrush="#2E405B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="6" Background="#070D17"
                            BorderBrush="#3A4B65" BorderThickness="1" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↗" FontSize="18" FontWeight="Bold"
                                       Foreground="#71A7FF" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <TextBox x:Name="UrlTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" Padding="2,10"
                                     ToolTip="Masukkan URL penuh, contoh https://example.com"/>
                        </Grid>
                    </Border>

                    <Button x:Name="AnalyzeButton" Grid.Column="1" Content="Analyze" Click="AnalyzeButton_Click"
                            MinWidth="112" Background="#1677FF" BorderBrush="#67A4FF"/>

                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="CancelButton_Click"
                            MinWidth="92" IsEnabled="False" Background="#172132" BorderBrush="#53627A"/>

                    <Button x:Name="ExportButton" Grid.Column="3" Content="Export CSV" Click="ExportButton_Click"
                            MinWidth="122" IsEnabled="False" Background="#12325D" BorderBrush="#426FAE"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ENGINE" Foreground="#AEBED2" FontWeight="Bold" FontSize="10" Margin="4,0,0,5"/>
                        <ComboBox x:Name="EngineComboBox" SelectedIndex="0" ToolTip="Auto cuba HTML dahulu dan menggunakan browser jika perlu">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Fast HTML"/>
                            <ComboBoxItem Content="Browser"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="OUTPUT" Foreground="#AEBED2" FontWeight="Bold" FontSize="10" Margin="4,0,0,5"/>
                        <ComboBox x:Name="OutputModeComboBox" SelectedIndex="0" ToolTip="Pilih cara hasil disusun">
                            <ComboBoxItem Content="Raw Data"/>
                            <ComboBoxItem Content="Smart Records"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="SEARCH CRITERIA" Foreground="#AEBED2" FontWeight="Bold" FontSize="10" Margin="4,0,0,5"/>
                        <ComboBox x:Name="SearchCriteriaComboBox" SelectedIndex="0" ToolTip="Pilih jenis data yang hendak dicari">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Text"/>
                            <ComboBoxItem Content="Title"/>
                            <ComboBoxItem Content="Price"/>
                            <ComboBoxItem Content="Image"/>
                            <ComboBoxItem Content="Video"/>
                            <ComboBoxItem Content="Audio"/>
                            <ComboBoxItem Content="Link"/>
                            <ComboBoxItem Content="Email"/>
                            <ComboBoxItem Content="Phone"/>
                            <ComboBoxItem Content="PDF"/>
                            <ComboBoxItem Content="Document"/>
                            <ComboBoxItem Content="CSV"/>
                            <ComboBoxItem Content="JSON"/>
                            <ComboBoxItem Content="Table"/>
                            <ComboBoxItem Content="Product"/>
                            <ComboBoxItem Content="Metadata"/>
                            <ComboBoxItem Content="Social"/>
                            <ComboBoxItem Content="Downloadable File"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#0A111D" BorderBrush="#2D405C" BorderThickness="1"
                            CornerRadius="6" Padding="12,8">
                        <TextBlock Text="Auto = fast HTML first, browser when needed"
                                   Foreground="#9FB0C7" FontSize="11"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Results and preview -->
        <Grid Grid.Row="2" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#354966"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              RowHeaderWidth="0" HeadersVisibility="Column"
                              SelectionChanged="ResultsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="ThumbnailColumn" Header="Preview" Width="92" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="74" Height="54" Background="#060A11" BorderBrush="#40516B"
                                                BorderThickness="1" CornerRadius="5" Margin="4">
                                            <Image Source="{Binding Value}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Source / Label" Binding="{Binding SourceUrl}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="SmartResultsGrid" ItemsSource="{Binding SmartResults}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              RowHeaderWidth="0" HeadersVisibility="Column" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
                            <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="260"/>
                            <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="*"/>
                            <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#273850" Visibility="Collapsed"/>

            <Border x:Name="PreviewPanel" Grid.Column="2" Margin="8,0,0,0" Padding="14"
                    Background="#0D1523" BorderBrush="#354966" BorderThickness="1"
                    CornerRadius="10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitleText" Text="Preview" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="PreviewTypeText" Text="Select a result" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#15335E" BorderBrush="#376CA8" BorderThickness="1"
                                CornerRadius="12" Padding="9,4" VerticalAlignment="Top">
                            <TextBlock Text="PREVIEW" Foreground="#CFE3FF" FontWeight="Bold" FontSize="9"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#050910" BorderBrush="#354966" BorderThickness="1"
                            CornerRadius="8" MinHeight="300">
                        <Grid>
                            <TextBlock x:Name="PreviewEmptyText" Text="Select a result to preview."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>

                            <Image x:Name="PreviewImage" Visibility="Collapsed" Stretch="Uniform" Margin="10"/>

                            <MediaElement x:Name="VideoPlayer" Visibility="Collapsed" LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop" Stretch="Uniform"
                                          MediaOpened="VideoPlayer_MediaOpened" MediaFailed="VideoPlayer_MediaFailed" Margin="8"/>

                            <Border x:Name="PdfPreviewPanel" Visibility="Collapsed" Width="210" Height="230"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
                                    Background="#151019" BorderBrush="#A84555" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="92" Height="112" CornerRadius="8" Background="#D43850" Margin="0,0,0,14">
                                        <TextBlock Text="PDF" FontSize="25" FontWeight="Black" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PDF document" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Open or save to inspect" Foreground="#C5B8C0" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="VideoControlsPanel" Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,10,0,2" Visibility="Collapsed">
                        <Button Content="Play" Click="PlayPreviewButton_Click" MinWidth="72"/>
                        <Button Content="Pause" Click="PausePreviewButton_Click" MinWidth="72" Background="#172132" BorderBrush="#53627A"/>
                        <Button Content="Stop" Click="StopPreviewButton_Click" MinWidth="72" Background="#172132" BorderBrush="#53627A"/>
                    </StackPanel>

                    <TextBlock x:Name="PreviewHintText" Grid.Row="3" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,8" Text="Preview ready."/>

                    <StackPanel Grid.Row="4">
                        <TextBox x:Name="PreviewUrlTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="58"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Selected resource" Foreground="#93A5BE"
                                       VerticalAlignment="Center" FontSize="11"/>
                            <Button x:Name="CopyPreviewUrlButton" Grid.Column="1" Content="Copy URL"
                                    Click="CopyPreviewUrlButton_Click" MinWidth="92" IsEnabled="False"
                                    Background="#172132" BorderBrush="#53627A"/>
                            <Button x:Name="OpenPreviewUrlButton" Grid.Column="2" Content="Open"
                                    Click="OpenPreviewUrlButton_Click" MinWidth="82" IsEnabled="False"/>
                            <Button x:Name="SavePreviewButton" Grid.Column="3" Content="Save As"
                                    Click="SavePreviewButton_Click" MinWidth="92" IsEnabled="False"
                                    Background="#C4771D" BorderBrush="#F2A342"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status footer -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,9" CornerRadius="8"
                Background="#0B1220" BorderBrush="#293B55" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="#DCE8F7" FontWeight="SemiBold" Text="Ready"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Grid.Column="1" Foreground="#B8C8DC" FontWeight="SemiBold" Text="0 records"/>
            </Grid>
        </Border>
    </Grid>
</Window>

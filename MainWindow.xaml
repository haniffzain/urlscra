<Window x:Class="URLScra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URLScra" Width="1380" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="{StaticResource URLScraAppIcon}">
    <Grid Margin="24" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource URLScraAppIcon}" Width="34" Height="34" Margin="0,0,10,0"/>
                <TextBlock Text="URLScra" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
            <TextBlock Text="Paste URL. Choose engine. Get data."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="44,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16" Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Margin="0,4,4,4"
                         FontSize="13"
                         ToolTip="Masukkan URL penuh, contoh https://example.com"/>

                <Button x:Name="AnalyzeButton"
                        Grid.Column="1"
                        Content="Analyze"
                        Click="AnalyzeButton_Click"
                        MinWidth="110"/>

                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        MinWidth="90"
                        IsEnabled="False"/>

                <Button x:Name="ExportButton"
                        Grid.Column="3"
                        Content="Export CSV"
                        Click="ExportButton_Click"
                        MinWidth="120"
                        IsEnabled="False"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Engine" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="EngineComboBox" SelectedIndex="0" Width="160" ToolTip="Auto cuba HTML dahulu dan menggunakan browser jika perlu">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Fast HTML"/>
                        <ComboBoxItem Content="Browser"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Output" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="OutputModeComboBox" SelectedIndex="0" Width="170" ToolTip="Pilih cara hasil disusun">
                        <ComboBoxItem Content="Raw Data"/>
                        <ComboBoxItem Content="Smart Records"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Search Criteria" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,4"/>
                    <ComboBox x:Name="SearchCriteriaComboBox" SelectedIndex="0" Width="210" ToolTip="Pilih jenis data yang hendak dicari">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Text"/>
                        <ComboBoxItem Content="Title"/>
                        <ComboBoxItem Content="Price"/>
                        <ComboBoxItem Content="Image"/>
                        <ComboBoxItem Content="Video"/>
                        <ComboBoxItem Content="Audio"/>
                        <ComboBoxItem Content="Link"/>
                        <ComboBoxItem Content="Email"/>
                        <ComboBoxItem Content="Phone"/>
                        <ComboBoxItem Content="PDF"/>
                        <ComboBoxItem Content="Document"/>
                        <ComboBoxItem Content="CSV"/>
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="Table"/>
                        <ComboBoxItem Content="Product"/>
                        <ComboBoxItem Content="Metadata"/>
                        <ComboBoxItem Content="Social"/>
                        <ComboBoxItem Content="Downloadable File"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <DataGrid x:Name="ResultsGrid"
                              ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionChanged="ResultsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="ThumbnailColumn" Header="Preview" Width="86" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="72" Height="54" Background="#060A11" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="4">
                                            <Image Source="{Binding Value}"
                                                   Stretch="UniformToFill"
                                                   SnapsToDevicePixels="True"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Source / Label" Binding="{Binding SourceUrl}" Width="280"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="SmartResultsGrid"
                              ItemsSource="{Binding SmartResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
                            <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="260"/>
                            <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="*"/>
                            <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#243247"
                          Visibility="Collapsed"/>

            <Border x:Name="PreviewPanel"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="14"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="PreviewTitleText"
                                   Text="Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="PreviewTypeText"
                                   Text="Select a result"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#060A11"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="260">
                        <Grid>
                            <TextBlock x:Name="PreviewEmptyText"
                                       Text="Select a result to preview."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24"/>

                            <Image x:Name="PreviewImage"
                                   Visibility="Collapsed"
                                   Stretch="Uniform"
                                   Margin="8"/>

                            <MediaElement x:Name="VideoPlayer"
                                          Visibility="Collapsed"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="Uniform"
                                          MediaOpened="VideoPlayer_MediaOpened"
                                          MediaFailed="VideoPlayer_MediaFailed"
                                          Margin="6"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="VideoControlsPanel"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,4"
                                Visibility="Collapsed">
                        <Button Content="Play" Click="PlayPreviewButton_Click" MinWidth="72"/>
                        <Button Content="Pause" Click="PausePreviewButton_Click" MinWidth="72"/>
                        <Button Content="Stop" Click="StopPreviewButton_Click" MinWidth="72"/>
                    </StackPanel>

                    <TextBlock x:Name="PreviewHintText"
                               Grid.Row="3"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8"
                               Text="Preview ready."/>

                    <StackPanel Grid.Row="4">
                        <TextBox x:Name="PreviewUrlTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="54"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CopyPreviewUrlButton"
                                    Content="Copy URL"
                                    Click="CopyPreviewUrlButton_Click"
                                    MinWidth="92"
                                    IsEnabled="False"/>
                            <Button x:Name="OpenPreviewUrlButton"
                                    Content="Open"
                                    Click="OpenPreviewUrlButton_Click"
                                    MinWidth="82"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Text="Ready"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Text="0 records"/>
        </Grid>
    </Grid>
</Window>

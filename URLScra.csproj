<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>URLScra</AssemblyName>
    <RootNamespace>URLScra</RootNamespace>
    <ApplicationIcon>Assets\urlscra.ico</ApplicationIcon>
    <Product>URLScra</Product>
    <Version>0.7.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
</Project>
